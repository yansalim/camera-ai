# Copie para deploy/.env e preencha:  cp deploy/.env.exemplo deploy/.env
# O deploy/.env nunca vai para o git (.gitignore). Nada aqui é segredo: o login do Google
# fica no arquivo apontado por ADC_ARQUIVO, fora do repositório.

# Subdomínio público; o Caddy emite o certificado HTTPS para ele.
# Para testar no próprio computador, sem certificado: DOMINIO=http://localhost
DOMINIO=arte.exemplo.com.br

# Provedor de IA: vertex (Google Cloud) ou falso (teste: devolve a própria foto saturada e desfocada, sem custo).
PROVEDOR=vertex
# Id do projeto no Google Cloud e região do Vertex AI (obrigatórios com vertex).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Modelo de imagem escolhido no teste comparativo (obrigatório com vertex).
MODELO_IMAGEM=

# Caminho, nesta máquina, do arquivo do login OAuth (gcloud auth application-default login).
# Fica fora do repositório, legível só pelo dono e pelo uid 1000; o pintor o recebe somente leitura.
# Com PROVEDOR=falso, aponte para um arquivo vazio: touch deploy/adc-vazio.json e ADC_ARQUIVO=./adc-vazio.json
ADC_ARQUIVO=/home/USUARIO/.config/gcloud/application_default_credentials.json

# Interruptor do evento: com false, o site mostra "Experiência pausada" e /api/pintar recusa pedidos.
EVENTO_ATIVO=false

# Proteções de custo. Vazio usa o padrão indicado.
# Pinturas por aparelho na janela, em minutos (5 / 10).
LIMITE_APARELHO=
JANELA_APARELHO_MIN=
# Pinturas por IP na janela, em minutos (60 / 60).
LIMITE_IP=
JANELA_IP_MIN=
# Máximo de pinturas por dia (1000).
TETO_DIARIO=
# Chamadas simultâneas ao provedor (5).
CONCORRENCIA=
# Tempo máximo de uma pintura em segundos, incluindo fila e nova tentativa (90).
TEMPO_MAXIMO_S=
